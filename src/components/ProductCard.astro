---
// Tarjeta de producto CON foto real. La foto y el nombre llevan a la ficha; «Pedir» abre
// WhatsApp con el producto (y el acabado elegido) ya escrito. Las variantes son reales:
// al elegir otro acabado cambia la foto y el mensaje, sin salir del catálogo.
import Foto from './Foto.astro';
import { precioTexto, urlFicha, type Producto } from '@/data/catalogo';
import { waProducto } from '@/lib/whatsapp';

interface Props {
  producto: Producto;
  /** sizes de la foto según la retícula de la sección. */
  sizes: string;
  /** Proporción del marco: 3:2 (alas) o 4:5 (verticales). */
  formato: 'ancho' | 'vertical';
  class?: string;
}

const { producto: p, sizes, formato, class: cls } = Astro.props;
const ficha = urlFicha(p)!;
const fichaAbs = new URL(ficha, Astro.site).href;
const opciones = p.variantes?.opciones ?? [];
const inicial = opciones[0];
const href = waProducto({ nombre: p.nombre, variante: inicial?.enMensaje, url: inicial ? `${fichaAbs}?acabado=${inicial.id}` : fichaAbs });
const precio = precioTexto(p);
const fotos = opciones.length ? opciones.map((o) => ({ id: o.foto, variante: o.id })) : [{ id: p.foto!, variante: null }];
---

<article
  class:list={['tarjeta', `tarjeta--${formato}`, cls]}
  data-tarjeta
  data-nombre={p.nombre}
  data-ficha={fichaAbs}
>
  <div class="tarjeta__foto">
    {
      fotos.map((f, i) => (
        <Foto
          id={f.id}
          recorte="card"
          sizes={sizes}
          class:list={['tarjeta__img', { 'is-activa': i === 0 }]}
          attrs={f.variante ? { 'data-variante-foto': f.variante } : {}}
        />
      ))
    }
  </div>
  <div class="tarjeta__tira">
    <h3 class="tarjeta__nombre">
      <a href={ficha} class="tarjeta__enlace" data-tarjeta-ficha><span class="tarjeta__nombre-txt">{p.nombre}</span></a>
    </h3>
    {precio && <p class="tarjeta__precio tnum">{precio}</p>}
    {
      opciones.length > 0 && (
        <div class="tarjeta__muestras" role="radiogroup" aria-label={`${p.variantes!.nombre} de ${p.nombre}`} data-variantes>
          {opciones.map((o, i) => (
            <button
              type="button"
              role="radio"
              class="muestra"
              aria-checked={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              data-variante={o.id}
              data-en-mensaje={o.enMensaje}
              style={`--muestra:${o.muestra}`}
            >
              <span class="muestra__color" aria-hidden="true" />
              <span class="visualmente-oculto">{o.nombre}</span>
            </button>
          ))}
        </div>
      )
    }
    <a class="tarjeta__pedir" href={href} target="_blank" rel="noopener" data-pedir>
      Pedir<span class="visualmente-oculto"> {p.nombre} por WhatsApp</span>
    </a>
  </div>
</article>

<style>
  .tarjeta {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--tarjeta-fondo, var(--blanco));
  }
  .tarjeta__foto {
    position: relative;
    display: grid;
    overflow: hidden;
    background: var(--blanco);
  }
  .tarjeta--ancho .tarjeta__foto {
    aspect-ratio: 3 / 2;
    place-items: center;
  }
  .tarjeta--vertical .tarjeta__foto {
    aspect-ratio: 4 / 5;
  }
  /* Las fotos de variantes van apiladas en la misma celda (cambio sin saltos). */
  .tarjeta__img {
    grid-area: 1 / 1;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition:
      opacity 200ms ease,
      transform 400ms var(--ease-out);
  }
  .tarjeta__img.is-activa {
    opacity: 1;
  }
  .tarjeta--ancho .tarjeta__img {
    width: 86%;
    height: auto;
    background: transparent;
  }
  .tarjeta--vertical .tarjeta__img :global(img) {
    object-fit: cover;
  }
  @media (hover: hover) and (pointer: fine) {
    .tarjeta:hover .tarjeta__img {
      transform: scale(1.03);
    }
  }

  /* Tira de pedido: [nombre | PEDIR] */
  .tarjeta__tira {
    flex: 1;
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--hilo-tarjeta, var(--hilo));
  }
  .tarjeta__nombre {
    padding: 14px 16px 12px;
    font: 600 16px/1.2 var(--font-display);
    letter-spacing: -0.01em;
  }
  .tarjeta__nombre-txt {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  /* Toda la tarjeta lleva a la ficha; los controles quedan por encima. */
  .tarjeta__enlace::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .tarjeta__enlace:focus-visible {
    outline: none;
  }
  .tarjeta__enlace:focus-visible::after {
    outline: 2px solid var(--foco, var(--negro));
    outline-offset: -2px;
  }
  .tarjeta__precio {
    padding: 0 16px 8px;
    font-weight: 600;
  }
  .tarjeta__muestras {
    position: relative;
    z-index: 1;
    display: flex;
    gap: 0;
    padding: 0 6px 6px;
  }
  .muestra {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
  }
  .muestra__color {
    width: 14px;
    height: 14px;
    background: var(--muestra);
    outline: 1px solid var(--hilo-tarjeta, var(--hilo));
    outline-offset: 0;
    transition: outline-offset 160ms ease-out;
  }
  .muestra[aria-checked='true'] .muestra__color {
    outline: 1px solid currentColor;
    outline-offset: 3px;
  }
  .tarjeta__pedir {
    position: relative;
    z-index: 1;
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    font: 600 12px/1.2 var(--font-text);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    background: var(--negro);
    color: var(--blanco);
    transition:
      background-color 160ms linear,
      color 160ms linear;
  }
  .tarjeta__pedir:hover {
    background: #262626;
  }

  @media (min-width: 768px) {
    .tarjeta__tira {
      flex: none;
      flex-direction: row;
      align-items: stretch;
      min-height: 56px;
    }
    .tarjeta__nombre {
      flex: 1;
      min-width: 0;
    }
    .tarjeta__nombre {
      align-self: center;
      padding: 12px 16px;
      font-size: 17px;
    }
    .tarjeta__precio {
      display: none;
    }
    .tarjeta__muestras {
      align-self: center;
      padding: 0 4px;
    }
    .tarjeta__pedir {
      flex: none;
      margin-top: 0;
      width: 96px;
      min-height: 56px;
      border-left: 1px solid var(--hilo-tarjeta, var(--hilo));
    }
  }
  @media (min-width: 1024px) {
    .tarjeta__nombre {
      font-size: 18px;
    }
  }

  /* Sobre fondo negro: contorno claro; al pasar el cursor, dorado. */
  :global(.sup-negro) .tarjeta {
    --tarjeta-fondo: var(--negro);
    --hilo-tarjeta: var(--gris);
  }
  :global(.sup-negro) .tarjeta__pedir {
    background: transparent;
    color: var(--blanco);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.24);
  }
  :global(.sup-negro) .tarjeta__pedir:hover {
    background: var(--dorado);
    color: var(--negro);
  }
  @media (min-width: 768px) {
    :global(.sup-negro) .tarjeta__pedir {
      box-shadow: none;
    }
  }
</style>
