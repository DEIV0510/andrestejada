---
// Instagram: bloque estático con detalles de fotos locales (acercamientos que no repiten
// el encuadre del catálogo) y enlace al perfil oficial. Sin feed incrustado ni API (no hay
// autorización) y sin cifras de seguidores.
import Foto from './Foto.astro';
import Icono from './Icono.astro';
import Externo from './Externo.astro';
import { INSTAGRAM } from '@/lib/contacto';
import type { MediaId } from '@/data/catalogo';

const FOTOS: MediaId[] = ['llavero-rbf', 'pines-esmaltados', 'alas-cessna'];
---

<section class="ig sup-blanco" aria-labelledby="ig-titulo">
  <div class="contenedor ig__reticula">
    <div class="ig__texto">
      <p class="rotulo texto-2">Instagram</p>
      <h2 id="ig-titulo" class="ig__usuario">
        <a href={INSTAGRAM.url} target="_blank" rel="noopener">@{INSTAGRAM.usuario}<Externo /></a>
      </h2>
      <p class="ig__bio texto-2">{INSTAGRAM.bio}</p>
      <a class="btn btn--contorno ig__cta" href={INSTAGRAM.url} target="_blank" rel="noopener">
        <Icono name="instagram" size={18} />
        Seguir en Instagram<Externo />
      </a>
    </div>
    <ul role="list" class="ig__fotos" aria-hidden="true">
      {
        FOTOS.map((id, i) => (
          <li>
            <a href={INSTAGRAM.url} target="_blank" rel="noopener" tabindex="-1" class="revela" style={`--orden:${i}`}>
              <Foto id={id} recorte="detalle" sizes="(min-width: 1328px) 230px, (min-width: 1024px) calc(19vw - 20px), calc((100vw - 34px) / 3)" class="ig__foto" alt="" />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .ig {
    padding-block: var(--seccion-y);
  }
  .ig__reticula {
    display: grid;
    gap: 32px;
  }
  .ig__texto {
    display: grid;
    justify-items: start;
    gap: 12px;
  }
  .ig__usuario {
    font: 800 28px/1.05 var(--font-display);
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .ig__usuario a {
    display: inline-block;
    padding-block: 4px;
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0% 2px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size 220ms ease-out;
  }
  .ig__usuario a:hover {
    background-size: 100% 2px;
  }
  .ig__bio {
    max-width: 44ch;
  }
  .ig__cta {
    margin-top: 8px;
  }
  .ig__fotos {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--hilo);
    border: 1px solid var(--hilo);
  }
  .ig__fotos a {
    display: block;
  }
  .ig__foto {
    aspect-ratio: 1;
  }
  .ig__foto :global(img) {
    object-fit: cover;
  }
  @media (min-width: 1024px) {
    .ig__reticula {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: center;
      column-gap: 24px;
    }
    .ig__texto {
      grid-column: 1 / span 5;
    }
    .ig__fotos {
      grid-column: 6 / span 7;
    }
    .ig__usuario {
      font-size: clamp(32px, 3.2vw, 44px);
    }
  }
</style>
