---
// Cabecera negra fija (sin transparencias). Escritorio: menú completo + WhatsApp.
// Móvil y tablet: logo · WhatsApp · MENÚ (cajón a pantalla completa, hermano del header
// para que el header sticky no lo atrape).
// Sin JavaScript, MENÚ es un enlace a #menu-movil y el cajón se abre con :target.
import Logo from './Logo.astro';
import Icono from './Icono.astro';
import Externo from './Externo.astro';
import { INSTAGRAM } from '@/lib/contacto';
import { MENSAJE_GENERAL, waUrl } from '@/lib/whatsapp';
import { NAV } from '@/lib/nav';

const wa = waUrl(MENSAJE_GENERAL);
---

<header class="header sup-negro" data-header>
  <div class="header__barra contenedor">
    <a href="/#inicio" class="header__logo" aria-label="Andrés Tejada Aviation Shop, inicio">
      <Logo version="compacto" alto={40} decorativo class="header__logo-svg" />
    </a>
    <nav class="header__nav" aria-label="Principal">
      <ul role="list">
        {
          NAV.map((l) => (
            <li>
              <a href={l.href} data-spy={l.id}>
                {l.texto}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="header__wa" href={wa} target="_blank" rel="noopener">
      <Icono name="whatsapp" size={22} />
      <span class="visualmente-oculto">Escribir por WhatsApp</span><Externo tipo="whatsapp" />
    </a>
    <a class="header__menu" href="#menu-movil" role="button" aria-expanded="false" aria-controls="menu-movil" data-menu-boton>
      <span data-menu-texto>Menú</span>
    </a>
  </div>
</header>

<div id="menu-movil" class="menu sup-negro" data-menu>
  <nav class="menu__nav contenedor" aria-label="Menú">
    <!-- Sin JS no hay botón que cierre el cajón: este enlace lo cierra (deja de ser :target) -->
    <a class="menu__cerrar" href="#contenido">Cerrar menú</a>
    <ol role="list">
      {
        NAV.map((l, i) => (
          <li style={`--i:${i}`}>
            <a href={l.href} data-spy={l.id} data-menu-enlace>
              <span class="menu__n" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              {l.texto}
            </a>
          </li>
        ))
      }
    </ol>
    <div class="menu__pie">
      <a class="btn btn--oro menu__cta" href={wa} target="_blank" rel="noopener">
        <Icono name="whatsapp" size={20} />
        Comprar por WhatsApp<Externo tipo="whatsapp" />
      </a>
      <a class="menu__ig" href={INSTAGRAM.url} target="_blank" rel="noopener">
        <Icono name="instagram" size={18} />@{INSTAGRAM.usuario}<Externo />
      </a>
    </div>
  </nav>
</div>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 60;
    height: var(--header-h);
    background: var(--negro);
    border-bottom: 1px solid transparent;
    transition: border-color 200ms linear;
  }
  .header:global(.is-scrolled) {
    border-bottom-color: var(--hilo-osc);
  }
  .header__barra {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .header__logo {
    display: flex;
    align-items: center;
    min-height: 44px;
    margin-right: auto;
  }
  .header__logo-svg {
    height: 26px;
    width: auto;
  }
  @media (min-width: 390px) {
    .header__logo-svg {
      height: 28px;
    }
  }
  @media (min-width: 768px) {
    .header__logo-svg {
      height: 34px;
    }
  }
  @media (min-width: 1280px) {
    .header__logo-svg {
      height: 40px;
    }
  }

  .header__nav {
    display: none;
  }
  @media (min-width: 1024px) {
    .header__nav {
      display: block;
      margin-right: clamp(12px, 2vw, 32px);
    }
    .header__nav ul {
      display: flex;
      gap: clamp(16px, 1.9vw, 32px);
    }
    .header__nav a {
      position: relative;
      display: flex;
      align-items: center;
      min-height: 44px;
      font: 600 12px/1 var(--font-menu);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      white-space: nowrap;
      color: var(--texto-2-osc);
      transition: color 160ms linear;
    }
    .header__nav a::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      bottom: 8px;
      height: 1px;
      background: currentColor;
      transform: scaleX(0);
      transform-origin: 0 50%;
      transition: transform 200ms ease-out;
    }
    .header__nav a:hover,
    .header__nav a[aria-current] {
      color: var(--blanco);
    }
    .header__nav a:hover::after {
      transform: none;
    }
    /* Sección activa: barra dorada de 2 px */
    .header__nav a[aria-current]::after {
      height: 2px;
      bottom: 7px;
      background: var(--dorado);
      transform: none;
    }
  }

  .header__wa {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    flex: none;
    color: var(--blanco);
    border: 1px solid rgba(255, 255, 255, 0.24);
    transition:
      border-color 160ms linear,
      background-color 160ms linear;
  }
  @media (hover: hover) {
    .header__wa:hover {
      border-color: var(--dorado);
    }
  }

  .header__menu {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    min-width: 80px;
    height: 44px;
    padding-left: 12px;
    font: 600 12px/1 var(--font-rotulo);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--blanco);
    cursor: pointer;
  }
  @media (min-width: 1024px) {
    .header__menu {
      display: none;
    }
  }

  /* ── Cajón móvil ── */
  .menu {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 55;
    padding-top: var(--header-h);
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--negro);
  }
  /* Sin JS: se abre al ser el destino del enlace MENÚ */
  .menu:target {
    display: block;
  }
  /* Con JS: clases del script (abrir/cerrar con animación) */
  :global(html.is-app) .menu {
    display: block;
    visibility: hidden;
    clip-path: inset(0 0 100% 0);
    transition:
      clip-path 200ms ease-in,
      visibility 0s linear 200ms;
  }
  :global(html.is-app) .menu:global(.is-open) {
    visibility: visible;
    clip-path: inset(0);
    transition:
      clip-path 280ms var(--ease-out),
      visibility 0s linear 0s;
  }
  @media (min-width: 1024px) {
    .menu,
    :global(html.is-app) .menu {
      display: none;
    }
  }
  .menu__nav {
    min-height: 100%;
    display: flex;
    flex-direction: column;
    padding-top: 8px;
    padding-bottom: calc(24px + env(safe-area-inset-bottom));
  }
  .menu__nav ol {
    border-top: 1px solid var(--gris);
  }
  .menu__nav li {
    border-bottom: 1px solid var(--hilo-osc);
  }
  :global(html.is-app) .menu__nav li {
    opacity: 0;
    transition: opacity 180ms linear;
  }
  :global(html.is-app) .menu:global(.is-open) li {
    opacity: 1;
    transition-delay: calc(80ms + var(--i) * 30ms);
  }
  .menu__nav li a {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding: 18px 0;
    font: 700 28px/1.1 var(--font-display);
    letter-spacing: -0.02em;
  }
  .menu__cerrar {
    display: none;
    align-self: flex-end;
    align-items: center;
    min-height: 44px;
    margin-bottom: 8px;
    font: 600 12px/1 var(--font-rotulo);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  :global(html:not(.is-app)) .menu__cerrar {
    display: inline-flex;
  }
  .menu__n {
    min-width: 2.2ch;
    font: 500 12px/1 var(--font-text);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
    color: var(--texto-3-osc);
  }
  /* Sección actual: barra dorada junto al número (forma, no solo color) */
  .menu__nav li a[aria-current] .menu__n {
    color: var(--dorado);
  }
  .menu__nav li a {
    position: relative;
  }
  .menu__nav li a[aria-current]::before {
    content: '';
    position: absolute;
    left: -12px;
    top: 50%;
    width: 3px;
    height: 28px;
    margin-top: -14px;
    background: var(--dorado);
  }
  .menu__pie {
    margin-top: auto;
    padding-top: 32px;
    display: grid;
    gap: 16px;
  }
  .menu__cta {
    width: 100%;
  }
  .menu__ig {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    font-weight: 500;
    color: var(--texto-2-osc);
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html.is-app) .menu,
    :global(html.is-app) .menu:global(.is-open) {
      clip-path: none;
    }
    :global(html.is-app) .menu {
      opacity: 0;
      transition:
        opacity 120ms linear,
        visibility 0s linear 120ms;
    }
    :global(html.is-app) .menu:global(.is-open) {
      opacity: 1;
      transition:
        opacity 120ms linear,
        visibility 0s linear 0s;
    }
  }
</style>
