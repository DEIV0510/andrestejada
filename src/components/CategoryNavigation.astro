---
// Índice del catálogo: tres celdas con la presilla de cada sección (1, 2 y 3 galones).
// Sin carrusel ni pestañas: enlaces directos a cada sección.
import Presilla from './Presilla.astro';
import Icono from './Icono.astro';
import { CATEGORIAS } from '@/data/catalogo';
---

<nav class="indice sup-negro" aria-label="Categorías del catálogo">
  <ul role="list" class="indice__lista contenedor">
    {
      CATEGORIAS.map((c, i) => (
        <li>
          <a class="indice__celda" href={`/#${c.id}`}>
            <span class="indice__n rotulo tnum" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <Presilla galones={c.galones} sobreNegro />
            <span class="indice__nombre">{c.nombre}</span>
            <Icono name="flecha" size={18} class="flecha indice__flecha" />
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .indice {
    border-top: 1px solid var(--gris);
  }
  .indice__lista {
    display: grid;
  }
  .indice__lista li + li {
    border-top: 1px solid var(--hilo-osc);
  }
  /* Móvil: una fila por categoría [n.º · presilla · nombre · flecha] */
  .indice__celda {
    display: grid;
    grid-template-columns: 20px 48px minmax(0, 1fr) auto;
    align-items: center;
    column-gap: 16px;
    min-height: 56px;
    padding: 6px 0;
    transition: background-color 160ms linear;
  }
  .indice__n {
    color: var(--texto-3-osc);
  }
  .indice__nombre {
    font: 600 18px/1.15 var(--font-display);
    letter-spacing: -0.01em;
  }
  .indice__flecha {
    color: var(--texto-2-osc);
  }
  /* Tableta y escritorio: panel de tres celdas; arriba presilla y número, abajo el
     nombre con su flecha (el nombre siempre cabe en una línea). */
  @media (min-width: 768px) {
    .indice__lista {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .indice__lista li + li {
      border-top: 0;
      border-left: 1px solid var(--gris);
    }
    .indice__celda {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        'presilla n'
        'nombre flecha';
      row-gap: 14px;
      align-content: center;
      min-height: 112px;
      padding: 20px 24px;
    }
    .indice__lista li:first-child .indice__celda {
      padding-left: 0;
    }
    .indice__lista li:last-child .indice__celda {
      padding-right: 0;
    }
    .indice__celda :global(.presilla) {
      grid-area: presilla;
    }
    .indice__n {
      grid-area: n;
      justify-self: end;
    }
    .indice__nombre {
      grid-area: nombre;
      font-size: 20px;
      white-space: nowrap;
    }
    .indice__flecha {
      grid-area: flecha;
    }
  }
  @media (min-width: 1024px) {
    .indice__nombre {
      font-size: 24px;
    }
  }
  @media (hover: hover) {
    .indice__celda:hover .indice__flecha {
      color: var(--dorado);
    }
  }
</style>
