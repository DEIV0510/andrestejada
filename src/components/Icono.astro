---
// Únicos íconos del sitio: WhatsApp (glifo oficial), Instagram y la flecha.
// Trazo 1.5 con extremos rectos, como los filetes de la página.
interface Props {
  name: 'whatsapp' | 'instagram' | 'flecha';
  size?: number;
  class?: string;
  label?: string;
}

const trazos = {
  instagram: '<path d="M4 4h16v16H4z"/><path d="M12 15.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Z"/><path d="M16.9 7.1h.01" stroke-width="2.2"/>',
  flecha: '<path d="M4 12h15M13.5 6.5 19 12l-5.5 5.5"/>',
} as const;

const whatsapp =
  '<path fill="currentColor" stroke="none" d="M12.04 2.5a9.43 9.43 0 0 0-8.1 14.27L2.5 21.5l4.86-1.4a9.44 9.44 0 1 0 4.68-17.6Zm0 17.27a7.83 7.83 0 0 1-3.99-1.09l-.29-.17-2.88.83.85-2.8-.19-.3a7.84 7.84 0 1 1 6.5 3.53Zm4.3-5.87c-.24-.12-1.4-.69-1.61-.77-.22-.08-.38-.12-.54.12s-.62.77-.76.93c-.14.16-.28.18-.52.06a6.4 6.4 0 0 1-1.89-1.17 7.1 7.1 0 0 1-1.31-1.63c-.14-.24 0-.37.1-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.3-.74-1.78-.2-.47-.4-.4-.54-.41h-.46a.88.88 0 0 0-.64.3 2.69 2.69 0 0 0-.84 2c0 1.18.86 2.32.98 2.48.12.16 1.69 2.58 4.1 3.62.57.25 1.02.4 1.37.5.58.19 1.1.16 1.52.1.46-.07 1.4-.57 1.6-1.13.2-.55.2-1.03.14-1.13-.06-.1-.22-.16-.46-.28Z"/>';

const { name, size = 24, class: cls, label } = Astro.props;
const body = name === 'whatsapp' ? whatsapp : trazos[name];
---

<svg
  class:list={['icono', cls]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="square"
  stroke-linejoin="miter"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={body}
/>
