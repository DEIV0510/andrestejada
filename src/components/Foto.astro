---
// <picture> con AVIF + WebP, anchos reales y dimensiones explícitas (sin saltos).
// El marco toma el color de fondo real de la foto mientras carga.
// diferida: la foto no se descarga hasta que el script la pide (variantes no elegidas);
// queda fuera del árbol accesible mientras no esté activa.
import type { MediaId } from '@/data/catalogo';
import { pictureData, type Recorte } from '@/lib/media';

interface Props {
  id: MediaId;
  sizes: string;
  recorte?: Recorte;
  alt?: string;
  /** Imagen del primer pantallazo (LCP): carga inmediata y prioridad alta. */
  priority?: boolean;
  diferida?: boolean;
  class?: string;
  /** Atributos extra para el <picture>. */
  attrs?: Record<string, string>;
  /** Atributos extra para el <img>. */
  imgAttrs?: Record<string, string>;
}

const { id, sizes, recorte = 'card', alt, priority = false, diferida = false, class: cls, attrs = {}, imgAttrs = {} } = Astro.props;
const d = pictureData(id, recorte);
const { style: estiloExtra = '', ...resto } = attrs;
const src = (v: string) => (diferida ? { 'data-srcset': v } : { srcset: v });
---

<picture class:list={['foto', cls]} {...resto} style={`--foto-bg:${d.bg};${estiloExtra}`} aria-hidden={diferida ? 'true' : undefined}>
  <source type="image/avif" {...src(d.avif)} sizes={sizes} />
  <source type="image/webp" {...src(d.webp)} sizes={sizes} />
  <img
    {...diferida ? { 'data-src': d.src } : { src: d.src }}
    width={d.width}
    height={d.height}
    alt={alt ?? d.alt}
    loading={priority ? 'eager' : 'lazy'}
    decoding={priority ? 'sync' : 'async'}
    fetchpriority={priority ? 'high' : undefined}
    onerror="this.closest('picture')?.classList.add('foto--error')"
    {...imgAttrs}
  />
</picture>
