---
// Marca: la presilla de cuatro galones (las cuatro franjas del emblema), el mensaje en dos
// líneas con una frase breve, una foto real que no se repite en el catálogo (el acabado
// plateado) y la franja de envíos. Sin cifras ni avales inventados.
import Presilla from './Presilla.astro';
import Foto from './Foto.astro';
import Icono from './Icono.astro';
import Externo from './Externo.astro';
import ShippingBenefits from './ShippingBenefits.astro';
import { MENSAJE_GENERAL, waUrl } from '@/lib/whatsapp';
---

<section class="marca sup-negro" aria-labelledby="marca-titulo">
  <div class="contenedor marca__reticula">
    <div class="marca__texto">
      <Presilla galones={4} ancho={96} sobreNegro animada />
      <p class="rotulo marca__rotulo">Tu vocación merece estar a la altura</p>
      <h2 id="marca-titulo" class="marca__titulo">
        Más que un uniforme. <span class="marca__linea2">Una forma de representar tu vocación.</span>
      </h2>
      <p class="marca__frase">Uniformes, alas y accesorios para estudiantes, pilotos y apasionados por la aviación.</p>
      <a class="btn btn--oro marca__cta" href={waUrl(MENSAJE_GENERAL)} target="_blank" rel="noopener">
        <Icono name="whatsapp" size={18} />
        Comprar por WhatsApp<Externo tipo="whatsapp" />
      </a>
    </div>
    <figure class="marca__foto">
      <a href="/catalogo/pin-avion-metalico/?acabado=plateado" class="marca__enlace">
        <Foto
          id="pin-avion-plateado"
          recorte="full"
          sizes="(min-width: 1328px) 384px, (min-width: 1024px) calc(33.3vw - 43px), (min-width: 768px) 480px, calc(100vw - 32px)"
          class="marca__img revela"
          alt="Pin avión metálico en acabado plateado sobre tela gris"
        />
      </a>
      <figcaption class="rotulo marca__pie">Pin avión metálico · acabado plateado</figcaption>
    </figure>
    <div class="marca__envios">
      <ShippingBenefits />
    </div>
  </div>
</section>

<style>
  .marca {
    padding-block: 80px;
  }
  .marca__reticula {
    display: grid;
    gap: 40px;
  }
  .marca__texto {
    display: grid;
    justify-items: start;
    gap: 20px;
  }
  .marca__rotulo {
    color: var(--texto-3-osc);
  }
  .marca__titulo {
    font: 700 30px/1.08 var(--font-display);
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .marca__linea2 {
    display: block;
    color: var(--texto-2-osc);
  }
  .marca__frase {
    max-width: 44ch;
    color: var(--texto-2-osc);
  }
  .marca__cta {
    margin-top: 4px;
  }
  .marca__foto {
    position: relative;
    max-width: 420px;
  }
  .marca__enlace {
    display: block;
  }
  .marca__img {
    aspect-ratio: 4 / 3;
  }
  .marca__img :global(img) {
    object-fit: cover;
    object-position: 50% 56%;
  }
  .marca__pie {
    margin-top: 10px;
    color: var(--texto-3-osc);
  }

  /* Tableta: apilado como en móvil (el titular necesita el ancho completo) */
  @media (min-width: 768px) {
    .marca__titulo {
      font-size: 40px;
    }
    .marca__foto {
      max-width: 480px;
    }
  }
  @media (min-width: 1024px) {
    .marca {
      padding-block: 128px;
    }
    .marca__reticula {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: center;
      column-gap: 24px;
      row-gap: 72px;
    }
    .marca__texto {
      grid-column: 1 / span 7;
      gap: 24px;
    }
    .marca__titulo {
      font-size: 52px;
      max-width: 13em;
    }
    .marca__foto {
      grid-column: 9 / span 4;
      max-width: none;
    }
    .marca__envios {
      grid-column: 1 / -1;
    }
    .marca__img {
      aspect-ratio: 4 / 5;
    }
  }
</style>
