---
import '@/styles/fuentes.css';
import '@/styles/global.css';
import fuentes from '@/data/fuentes.json';
import MarcaSprite from '@/components/MarcaSprite.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import WhatsAppButton from '@/components/WhatsAppButton.astro';
import Preloader from '@/components/Preloader.astro';
import { INSTAGRAM, MARCA, WHATSAPP_E164 } from '@/lib/contacto';

interface Props {
  title: string;
  description: string;
  /** Ruta de la imagen Open Graph (relativa al sitio). */
  og?: string;
  ogAlt?: string;
  /** Imagen a precargar (LCP): srcset AVIF del hero. */
  preload?: { srcset: string; sizes: string } | null;
  /** Solo la portada muestra la pantalla de carga. */
  intro?: boolean;
  /** Datos estructurados adicionales (JSON-LD). */
  jsonld?: Record<string, unknown>[];
  /** Botón flotante de WhatsApp (las fichas usan su propia barra). */
  flotante?: boolean;
  /** Páginas que no deben indexarse (404): sin canonical ni og:url. */
  noindex?: boolean;
}

const {
  title,
  description,
  og = '/og.jpg',
  ogAlt = 'Andrés Tejada Aviation Shop: uniformes, accesorios y aviones a escala',
  preload = null,
  intro = false,
  jsonld = [],
  flotante = true,
  noindex = false,
} = Astro.props;

const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).href;
const ogUrl = new URL(og, site).href;

// Datos estructurados: solo información real (nombre, web, logo, redes, contacto, país).
const tienda = {
  '@context': 'https://schema.org',
  '@type': 'OnlineStore',
  name: MARCA.nombre,
  url: new URL('/', site).href,
  logo: new URL('/icon-512.png', site).href,
  image: new URL('/og.jpg', site).href,
  description: 'Tienda virtual de uniformes de piloto, accesorios de aviación y aviones a escala con envíos a toda Colombia.',
  sameAs: [INSTAGRAM.url],
  areaServed: { '@type': 'Country', name: 'Colombia' },
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: `+${WHATSAPP_E164}`,
    contactType: 'sales',
    areaServed: 'CO',
    availableLanguage: 'es',
  },
};
const datos = noindex ? [] : [tienda, ...jsonld];
---

<!doctype html>
<html lang="es-CO" data-intro={intro ? '1' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#090909" />
    <meta name="format-detection" content="telephone=no" />

    <!-- Arranque, antes del primer pintado:
         · is-js: hay JavaScript (la entrada del hero puede animarse).
         · Pantalla de carga solo en la 1.ª visita al sitio, en la portada, con movimiento
           permitido y sin conexión lenta. Su salida se decide aquí, sin esperar al módulo.
         · El indicador avanza solo con hitos reales: documento, tipografía, foto principal. -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('is-js');
        var intro = false;
        try {
          var reducir = matchMedia('(prefers-reduced-motion: reduce)').matches;
          var c = navigator.connection;
          var lenta = !!(c && (c.saveData || /(^|-)(2g|3g)$/.test(c.effectiveType || '')));
          var visto = localStorage.getItem('at_intro');
          localStorage.setItem('at_intro', '1');
          intro = d.getAttribute('data-intro') === '1' && !reducir && !lenta && !visto;
        } catch (e) {}
        if (!intro) {
          d.classList.add('is-ready');
          return;
        }
        d.classList.add('is-intro');
        var hechos = 0;
        var cerrado = false;
        function hito() {
          hechos++;
          d.style.setProperty('--intro-p', String(Math.min(hechos, 3) / 3));
        }
        function cerrar() {
          if (cerrado) return;
          cerrado = true;
          d.classList.add('is-intro-out', 'is-ready');
          setTimeout(function () {
            d.classList.remove('is-intro', 'is-intro-out');
          }, 480);
        }
        function alListo() {
          hito();
          var foto = document.querySelector('img[fetchpriority="high"]');
          if (foto) {
            if (foto.complete) hito();
            else {
              foto.addEventListener('load', hito, { once: true });
              foto.addEventListener('error', hito, { once: true });
            }
          }
          if (document.fonts && document.fonts.load) document.fonts.load('700 1em Manrope').then(hito, hito);
          // El mínimo perceptible se cuenta desde que la pantalla de carga se pinta de verdad;
          // si ese pintado llega tarde, solo se asoma. Nunca pasa de ~1,4 s.
          requestAnimationFrame(function () {
            requestAnimationFrame(function () {
              var resta = Math.max(250, Math.min(650, 1400 - performance.now()));
              setTimeout(cerrar, resta);
            });
          });
        }
        if (document.readyState !== 'loading') alListo();
        else document.addEventListener('DOMContentLoaded', alListo, { once: true });
        // Tope absoluto (pestaña en segundo plano, rAF detenido, etc.)
        setTimeout(cerrar, 2000);
      })();
    </script>

    <link rel="preload" href={fuentes.manrope} as="font" type="font/woff2" crossorigin />
    {preload && <link rel="preload" as="image" type="image/avif" imagesrcset={preload.srcset} imagesizes={preload.sizes} fetchpriority="high" />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content={MARCA.nombre} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    {datos.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body>
    <MarcaSprite />
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    {intro && <Preloader />}
    <Header />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Footer />
    {flotante && <WhatsAppButton />}
    <script>
      import '@/scripts/app';
    </script>
  </body>
</html>
